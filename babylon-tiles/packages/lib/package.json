{
	"name": "@babylon-tile/lib",
	"version": "1.0.0",
	"type": "module",
	"files": [
		"dist"
	],
	"main": "./dist/index.umd.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.umd.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"description": "A lightweight tile map using Babylon.js",
	"license": "MIT",
	"author": {
		"name": "Babylon-Tile Team",
		"email": "team@example.com"
	},
	"keywords": [
		"babylonjs",
		"gis",
		"tile",
		"map",
		"3D",
		"cesium",
		"mapbox"
	],
	"scripts": {
		"dev": "vite build --watch",
		"build": "tsc && vite build"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/your-repo/babylon-tile.git"
	},
	"bugs": {
		"url": "https://github.com/your-repo/babylon-tile/issues"
	},
	"homepage": "https://github.com/your-repo/babylon-tile#readme",
	"dependencies": {
		"@babylonjs/core": "^9.21.2",
		"@babylonjs/loaders": "^9.21.2",
		"lerc": "^4.2.0",
		"@mapbox/vector-tile": "^2.0.3",
		"pbf": "^4.0.1"
	},
	"devDependencies": {
		"@types/node": "^20.11.5",
		"typescript": "^5.3.3",
		"vite": "^5.0.12",
		"vite-plugin-dts": "^3.7.3"
	}
}
