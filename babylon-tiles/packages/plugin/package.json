{
	"name": "@babylon-tile/plugin",
	"version": "1.0.0",
	"type": "module",
	"files": [
		"dist"
	],
	"main": "./dist/index.umd.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.umd.cjs",
			"types": "./dist/index.d.ts"
		}
	},
	"description": "A lightweight tile map using Babylon.js - plugins",
	"license": "MIT",
	"author": {
		"name": "Babylon-Tile Team",
		"email": "team@example.com"
	},
	"keywords": [
		"babylonjs",
		"gis",
		"tile",
		"map",
		"3D",
		"cesium",
		"mapbox"
	],
	"scripts": {
		"dev": "vite build --watch",
		"build": "tsc && vite build"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"dependencies": {
		"@babylon-tile/lib": "workspace:*",
		"@babylonjs/core": "^7.8.1",
		"@mapbox/vector-tile": "^2.0.3",
		"geojson-vt": "^4.0.2",
		"pbf": "^4.0.1",
		"utif": "^3.1.0"
	},
	"devDependencies": {
		"@types/geojson-vt": "^3.2.5",
		"@types/node": "^20.11.5",
		"@types/utif": "^3.0.6",
		"typescript": "^5.3.3",
		"vite": "^5.0.12",
		"vite-plugin-dts": "^3.7.3"
	}
}
